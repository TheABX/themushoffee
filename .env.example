# Email delivery for the "Notify Me" waitlist form and the /contact form.
# Sign up free at https://resend.com, verify a sending domain (or use their
# shared onboarding@resend.dev sender for quick testing), then create an API key.
RESEND_API_KEY=

# Where waitlist signups and contact form messages get emailed to.
NOTIFY_EMAIL_TO=you@yourdomain.com

# Optional: the "From" address used when sending notification emails.
# Must be on a domain you've verified in Resend (or leave unset to use
# Resend's shared testing sender).
NOTIFY_EMAIL_FROM=Mushoffee Waitlist <onboarding@resend.dev>
